{
  "name": "arena-negotiations",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:ui": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:logic": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test": "npm run test:logic && npm run test:api && npm run test:ui",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --watch --experimental-strip-types server/index.ts",
    "start": "node --experimental-strip-types server/index.ts",
    "db:migrate": "node --experimental-strip-types server/migrate.ts",
    "db:seed": "node --experimental-strip-types server/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test:api": "node --experimental-strip-types --test tests/api/*.test.ts",
    "test:api:embedded": "node scripts/test-embedded.mjs",
    "test:ui:embedded": "node scripts/test-ui-embedded.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@xyflow/react": "12.11.6",
    "dotenv": "18.0.1",
    "express": "5.2.1",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.7",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
