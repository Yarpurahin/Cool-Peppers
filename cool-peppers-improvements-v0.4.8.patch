+
+/* Shared preferences, account images and service notification. */
+.theme-toggle {
+  position: relative;
+  display: inline-flex;
+  align-items: center;
+  flex-shrink: 0;
+  gap: 6px;
+  padding: 7px 9px;
+  border: 1px solid var(--line);
+  border-radius: 9px;
+  color: var(--ink);
+  background: var(--surface);
+}
+.theme-toggle select {
+  cursor: pointer;
+  min-width: 0;
+  padding: 0;
+  border: 0;
+  width: 108px;
+  color: inherit;
+  background: transparent;
+  font-size: 11px;
+}
+.theme-toggle:focus-within {
+  outline: 2px solid var(--focus);
+  outline-offset: 3px;
+}
+.user-avatar {
+  overflow: hidden;
+  flex-shrink: 0;
+}
+.user-avatar img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  border-radius: inherit;
+}
+.avatar-settings {
+  display: flex;
+  align-items: center;
+  gap: 20px;
+  margin: 0 0 24px;
+  padding: 0 0 24px;
+  border-bottom: 1px solid var(--line);
+}
+.avatar-settings p {
+  font-size: 12px;
+  color: var(--muted);
+  margin: 8px 0;
+}
+.avatar-settings .button-row {
+  gap: 8px;
+  margin-top: 12px;
+  flex-wrap: wrap;
+}
+.admin-account-form {
+  display: grid;
+  gap: 20px;
+  max-width: 640px;
+  padding: 28px;
+}
+.service-notice {
+  position: fixed;
+  z-index: 10000;
+  right: 24px;
+  top: 24px;
+  width: min(440px, calc(100vw - 32px));
+  display: flex;
+  gap: 14px;
+  align-items: flex-start;
+  padding: 20px;
+  border: 1px solid var(--line);
+  border-left: 4px solid var(--orange);
+  border-radius: 16px;
+  color: var(--ink);
+  background: var(--surface);
+  box-shadow: 0 12px 48px rgb(0 0 0 / 18%);
+  animation: notice-enter 220ms ease-out both;
+}
+.service-notice > div {
+  flex: 1;
+  min-width: 0;
+}
+.service-notice strong {
+  display: block;
+  font-size: 14px;
+}
+.service-notice p {
+  margin-top: 5px;
+  color: var(--muted);
+  font-size: 12px;
+  line-height: 1.65;
+}
+.service-notice-icon {
+  color: var(--orange);
+  background: var(--peach);
+  border-radius: 10px;
+  padding: 9px;
+}
+.service-notice .icon-button {
+  min-width: 28px;
+  min-height: 28px;
+  border: 0;
+  padding: 4px;
+  flex-shrink: 0;
+}
+.service-notice.is-closing {
+  animation: notice-exit 220ms ease-in both;
+  pointer-events: none;
+}
+@keyframes notice-enter {
+  from {
+    opacity: 0;
+    transform: translateY(-14px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+@keyframes notice-exit {
+  from {
+    opacity: 1;
+    transform: translateY(0);
+  }
+  to {
+    opacity: 0;
+    transform: translateY(-14px);
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .service-notice,
+  .service-notice.is-closing {
+    animation-duration: 1ms;
+  }
+}
+@media (max-width: 760px) {
+  .theme-toggle {
+    width: 38px;
+    height: 38px;
+    padding: 8px;
+  }
+  .theme-toggle select {
+    position: absolute;
+    inset: 0;
+    opacity: 0;
+    width: 100%;
+    height: 100%;
+  }
+  .header-inner > .theme-toggle {
+    margin-left: auto;
+  }
+  .service-notice {
+    top: 12px;
+    right: 16px;
+    padding: 15px;
+    gap: 10px;
+  }
+  .avatar-settings {
+    align-items: flex-start;
+    gap: 14px;
+  }
+}
+:root[data-theme='dark'] .account-menu-popover,
+:root[data-theme='dark'] .site-header {
+  background: var(--surface);
+}
+:root[data-theme='dark'] .stat--dark p {
+  color: var(--on-accent);
+}
+
+.theme-toggle select {
+  min-height: 0;
+  height: 22px;
+}
+:root[data-theme='dark'] .scenario-cover .cover-label,
+:root[data-theme='dark'] .account-role-badge {
+  background: var(--surface);
+}
+@media (max-width: 760px) {
+  .theme-toggle select {
+    height: 100%;
+  }
+}
