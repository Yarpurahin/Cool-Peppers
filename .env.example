# # PostgreSQL on your computer (never use a VITE_ prefix for credentials).
# DATABASE_URL=postgresql://arena:penis@127.0.0.1:5432/arena
# API_HOST=127.0.0.1
# API_PORT=3001
# APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3001,http://127.0.0.1:3001
# COOKIE_SECURE=false

# # Optional bootstrap administrator. Uncomment all three lines and change the values.
# # The account is created by `npm run db:setup` / `npm run db:seed`.
# # If ADMIN_EMAIL already belongs to a user, that user is promoted to admin and their password is kept.
# ADMIN_NAME=Admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=admin

# # Optional: Docker Compose starts only PostgreSQL.
# POSTGRES_DB=arena
# POSTGRES_USER=arena
# POSTGRES_PASSWORD=Yarpurahin_246813579
# POSTGRES_PORT=5432

# # Optional integration tests: use a separate database with CREATE SCHEMA permission.
# # TEST_DATABASE_URL=postgresql://arena:change_me@127.0.0.1:5432/arena_test
