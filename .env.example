# Docker PostgreSQL. Change this password before sharing or deploying the project.
POSTGRES_DB=arena
POSTGRES_USER=arena
POSTGRES_PASSWORD=change_me_strong_password

# Published web port on the host. PostgreSQL stays inside the Docker network by default.
APP_PORT=3001
APP_ORIGIN=http://localhost:3001,http://127.0.0.1:3001
COOKIE_SECURE=false

# Optional bootstrap super-administrator. Either set all three values or leave all three empty.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Only needed for running Node directly on the host instead of through Docker.
DATABASE_URL=postgresql://arena:change_me_strong_password@127.0.0.1:5432/arena
POSTGRES_PORT=5432
