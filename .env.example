# Docker PostgreSQL. Set a password before starting a NEW database.
# For an existing Docker volume, keep the password it was initialized with.
POSTGRES_DB=arena
POSTGRES_USER=arena
POSTGRES_PASSWORD=change_me_strong_password

# Web application published on the host.
APP_PORT=3001
APP_ORIGIN=http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
COOKIE_SECURE=false

# Optional host access. Only compose.db-port.yaml publishes this port.
# The app container connects to postgres:5432 independently of these values.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://arena:change_me_strong_password@127.0.0.1:5433/arena

# Optional first administrator. Uncomment all three lines and set your values.
# ADMIN_NAME=Administrator
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change_me_admin

# Optional public origin used by the frontend build for canonical URLs.
# VITE_SITE_URL=https://example.com
